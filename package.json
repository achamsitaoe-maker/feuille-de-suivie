{
  "name": "feuille-de-suivie",
  "version": "1.0.0",
  "description": "Application mobile de suivi des revenus journaliers avec stockage Google Drive",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace feuilleDeSuivie.xcworkspace -scheme feuilleDeSuivie -configuration Release"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/stack": "^6.3.0",
    "react-native-screens": "^3.20.0",
    "react-native-safe-area-context": "^4.5.0",
    "@react-native-google-signin/google-signin": "^10.0.0",
    "google-drive-api": "^1.0.0",
    "@react-native-firebase/app": "^17.0.0",
    "@react-native-firebase/firestore": "^17.0.0",
    "@react-native-firebase/auth": "^17.0.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-svg": "^13.9.0",
    "redux": "^4.2.1",
    "@reduxjs/toolkit": "^1.9.5",
    "react-redux": "^8.1.1",
    "axios": "^1.4.0",
    "moment": "^2.29.4",
    "react-native-vector-icons": "^9.2.0",
    "react-native-toast-message": "^2.1.5",
    "react-native-uuid": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.22.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "typescript": "^5.1.0",
    "jest": "^29.5.0",
    "@testing-library/react-native": "^12.0.0"
  },
  "jest": {
    "preset": "react-native"
  }
}
